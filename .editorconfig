root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,sln}]
indent_size = 4

[*.{json,jsonc,yml,yaml,js,mjs,cjs,ts,tsx,vue,css,scss,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
