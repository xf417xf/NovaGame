<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <NovaGameRepositoryRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\..\..'))</NovaGameRepositoryRoot>
  </PropertyGroup>
  <Target Name="PreserveExternalProjectReferenceConfiguration" AfterTargets="AssignProjectConfiguration">
    <ItemGroup>
      <ProjectReferenceWithConfiguration Update="@(ProjectReferenceWithConfiguration)">
        <SetConfiguration>%(ProjectReferenceWithConfiguration.SetConfiguration);ShouldUnsetParentConfigurationAndPlatform=false</SetConfiguration>
      </ProjectReferenceWithConfiguration>
    </ItemGroup>
  </Target>
</Project>
