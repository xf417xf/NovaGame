{
  "ConnectionStrings": {
    "NovaGame": "",
    "SwordMaster": ""
  },
  "NovaGame": {
    "EntityFrameworkCore": {
      "ConnectionStringName": "NovaGame",
      "ServerVersion": "8.4.0"
    },
    "AdminAccess": {
      "Jwt": {
        "Issuer": "NovaGame",
        "Audience": "NovaGame.Admin",
        "SigningKey": "",
        "ClockSkew": "00:00:30"
      },
      "LoginRateLimit": {
        "PermitLimit": 5,
        "Window": "00:01:00",
        "QueueLimit": 0
      },
      "Seed": {
        "UserName": "",
        "Password": "",
        "DisplayName": "Administrator"
      }
    }
  },
  "SwordMaster": {
    "EntityFrameworkCore": {
      "ConnectionStringName": "SwordMaster",
      "ServerVersion": "8.4.0"
    },
    "PlayerAuthentication": {
      "Jwt": {
        "Issuer": "SwordMaster",
        "Audience": "SwordMaster.Player",
        "SigningKey": "",
        "ClockSkew": "00:00:30"
      }
    },
    "GameConfig": {
      "Environment": "development"
    }
  },
  "NovaCore": {
    "HealthChecks": {
      "LivenessPath": "/health/live",
      "ReadinessPath": "/health/ready",
      "CompatibilityReadinessPaths": [
        "/health",
        "/api/health"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
