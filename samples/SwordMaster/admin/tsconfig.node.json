{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@vben/tsconfig/node.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "e2e/**/*.ts",
    "oxfmt.config.mts",
    "oxlint.config.mts",
    "playwright.config.ts",
    "vite.config.mts",
    "vitest.config.mts"
  ]
}
